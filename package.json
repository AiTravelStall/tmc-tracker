{
  "name": "tmc-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TMC school outreach tracker: telemarketing, follow-ups and sales visits with role-based access",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:create-admin": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/list": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "csv-parse": "7.0.3",
    "lucide-react": "1.66.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.5",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.2.1",
    "@vinext/cloudflare": "1.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-rc.6",
    "eslint": "9.36.0",
    "eslint-config-next": "16.4.6",
    "postgres": "3.4.7",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
