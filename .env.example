# ── Supabase (Project Settings → API) ─────────────────────────────
# Public values: safe for the browser bundle, but the app only uses them server-side (BFF).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API Keys → "Publishable key" (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). Server-only. Bypasses RLS: used for user management and CSV import.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Database (Project Settings → Database → Connection string → URI, "Session pooler") ──
# Only needed by `npm run db:migrate`.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Business timezone used for "today" and dashboard day buckets.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# ── First admin (used once by `npm run db:create-admin`) ──────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Call recordings (Salestrail) — optional; the Recordings page shows setup steps until set ──
# Salestrail owner: callanalytics.salestrail.io/integration/apidocs → generate username/password.
SALESTRAIL_API_USERNAME=
SALESTRAIL_API_PASSWORD=
# Free key from console.groq.com. Optional: without it transcripts use Cloudflare Workers AI only.
GROQ_API_KEY=
# Random string (24+ chars) the Worker cron uses to call /api/cron/salestrail. `openssl rand -hex 32`
CRON_SECRET=
